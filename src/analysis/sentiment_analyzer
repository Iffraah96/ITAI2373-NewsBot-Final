import nltk
from nltk.sentiment import SentimentIntensityAnalyzer
import pandas as pd
import numpy as np

class SentimentEvolutionTracker:
    """
    Advanced sentiment analysis with temporal and contextual understanding
    """

    def __init__(self):
        self.analyzer = SentimentIntensityAnalyzer()

    def analyze_sentiment(self, article_text):
        """
        Comprehensive sentiment analysis using VADER.
        Returns overall sentiment, confidence score, and emotional dimensions (VADER scores).
        """
        vs = self.analyzer.polarity_scores(article_text)

        if vs['compound'] >= 0.05:
            overall_sentiment = "positive"
        elif vs['compound'] <= -0.05:
            overall_sentiment = "negative"
        else:
            overall_sentiment = "neutral"

        return {
            "overall_sentiment": overall_sentiment,
            "confidence": float(vs['compound']), # Compound score as confidence
            "vader_scores": vs,
            "key_phrases_driving_sentiment": "(VADER is lexicon-based, so specific phrases are not directly extracted without further processing)" # Placeholder
        }

    def track_sentiment_over_time(self, articles_with_dates):
        """
        Analyze sentiment trends over time.
        articles_with_dates = [(text, datetime_object), ...]
        """
        records = []
        for text, date_obj in articles_with_dates:
            sentiment_result = self.analyze_sentiment(text)
            records.append({
                "date": pd.to_datetime(date_obj).date(),
                "compound_sentiment": sentiment_result["confidence"],
                "overall_sentiment": sentiment_result["overall_sentiment"]
            })

        df = pd.DataFrame(records)
        if df.empty:
            return pd.DataFrame() # Return empty DataFrame if no data

        # Aggregate by date for daily average sentiment
        daily_sentiment = df.groupby('date')['compound_sentiment'].mean().reset_index()
        daily_sentiment.set_index('date', inplace=True)
        daily_sentiment.sort_index(inplace=True)

        return daily_sentiment

    def detect_sentiment_anomalies(self, sentiment_timeline_df, window_size=7, threshold_std=2):
        """
        Identify unusual sentiment patterns.
        sentiment_timeline_df is a DataFrame with 'date' as index and 'compound_sentiment' column.
        """
        if sentiment_timeline_df.empty or 'compound_sentiment' not in sentiment_timeline_df.columns:
            return pd.DataFrame() # Return empty DataFrame if no data or wrong column

        # Calculate rolling mean and standard deviation
        rolling_mean = sentiment_timeline_df['compound_sentiment'].rolling(window=window_size).mean()
        rolling_std = sentiment_timeline_df['compound_sentiment'].rolling(window=window_size).std()

        # Calculate upper and lower bounds for anomalies
        upper_bound = rolling_mean + (rolling_std * threshold_std)
        lower_bound = rolling_mean - (rolling_std * threshold_std)

        # Identify anomalies
        anomalies = sentiment_timeline_df[
            (sentiment_timeline_df['compound_sentiment'] > upper_bound) |
            (sentiment_timeline_df['compound_sentiment'] < lower_bound)
        ]

        return anomalies

