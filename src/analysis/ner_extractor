# 🧪 Example Usage
# -------------------------------

if __name__ == "__main__":
    mapper = EntityRelationshipMapper()

    text = "Elon Musk is the CEO of Tesla. Tesla is based in the United States."

    print("🧠 Entities:")
    print(mapper.extract_entities(text))

    print("\n🔗 Relationships:")
    print(mapper.extract_relationships(text))

    mapper.build_knowledge_graph([text])

    print("\n🔍 Connection (Elon Musk → United States):")
    print(mapper.find_entity_connections("Elon Musk", "United States"))

print("🕸️ Entity relationship mapper ready for implementation!")
